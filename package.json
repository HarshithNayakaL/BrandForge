{
  "name": "brandforge",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*",
    "web"
  ],
  "scripts": {
    "setup": "npm install && npx playwright install chromium",
    "dev": "concurrently -n api,crawler,web -c cyan,magenta,green \"npm:dev:api\" \"npm:dev:crawler\" \"npm:dev:web\"",
    "dev:api": "node --watch services/api/src/server.js",
    "dev:crawler": "node --watch services/crawler/src/server.js",
    "dev:web": "npm run dev -w web",
    "start:api": "node services/api/src/server.js",
    "start:crawler": "node services/crawler/src/server.js",
    "n8n": "n8n start",
    "test": "node --test \"tests/*.test.js\"",
    "build:n8n": "node scripts/build-n8n-workflow.mjs",
    "preflight": "node scripts/preflight.mjs",
    "verify": "node scripts/verify.mjs",
    "check:ui": "node scripts/ui-check.mjs",
    "check:contrast": "node scripts/check-contrast.mjs",
    "check:workflow": "node scripts/check-workflow.mjs",
    "fixtures": "node scripts/seed-fixtures.mjs",
    "fixtures:clean": "node scripts/seed-fixtures.mjs --clean"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "dotenv": "^17.4.2"
  }
}
