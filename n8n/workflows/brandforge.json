      "id": "bf-node-010",
      "name": "11 Campaign Planner",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1380,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// One item per shot. The HTTP node below then issues them with bounded\n// concurrency via its batching options.\nconst runId = $('Init Run Context').first().json.run_id;\nconst shots = $input.first().json.shots ?? [];\n\nif (!Array.isArray(shots) || shots.length !== 6) {\n  throw new Error('CAMPAIGN_PLANNING_FAILED: expected 6 shot contracts, got ' + (shots?.length ?? 0));\n}\n\nreturn shots.map((s) => ({ json: { run_id: runId, shot_id: s.shot_id, purpose: s.purpose } }));"
      },
      "id": "bf-node-011",
      "name": "13 Split Six Shots",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1620,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3001/internal/shot",
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={{ JSON.stringify({ \"x-internal-token\": $('Init Run Context').first().json.internal_token }) }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ run_id: $json.run_id, shot_id: $json.shot_id }) }}",
        "options": {
          "timeout": 900000,
          "batching": {
            "batch": {
              "batchSize": 3,
              "batchInterval": 1000
            }
          },
          "response": {
            "response": {
              "neverError": true,
              "fullResponse": false
            }
          }
        }
      },
      "id": "bf-node-012",
      "name": "14 Generate + QA Shot",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1860,
        300
      ],
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Summarise the six outcomes. The api has already persisted each shot's\n// result; this is the orchestrator's own view for logging and routing.\nconst runId = $('Init Run Context').first().json.run_id;\nconst items = $input.all().map((i) => i.json ?? {});\n\nconst results = items.map((r) => ({\n  shot_id: r.shot_id ?? null,\n  status: r.status ?? 'FAILED',\n  ok: r.success === true,\n  repair_attempts: r.repair_attempts ?? 0,\n  product_accuracy: r.product_accuracy ?? null,\n  error: r.error ?? null,\n}));\n\nconst accepted = results.filter((r) => r.status === 'ACCEPTED').length;\n\nreturn [{\n  json: {\n    run_id: runId,\n    shot_count: results.length,\n    accepted,\n    blocked: results.length - accepted,\n    results,\n  },\n}];"
      },
      "id": "bf-node-013",
      "name": "19 Aggregate Campaign",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2100,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3001/internal/finalize",
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={{ JSON.stringify({ \"x-internal-token\": $('Init Run Context').first().json.internal_token }) }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ run_id: $('Init Run Context').first().json.run_id }) }}",
        "options": {
          "timeout": 120000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "bf-node-014",
      "name": "20 Finalize + Manifest",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        2340,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {},
      "id": "bf-node-015",
      "name": "21 Run Complete",
      "type": "n8n-nodes-base.noOp",
      "typeVersion": 1,
      "position": [
        2580,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Bounded failure: no retry loop here. The api already recorded the run as\n// FAILED with a failure_code; retrying a stage that spent model calls would\n// double-bill it.\nconst runId = $('Init Run Context').first().json.run_id;\nconst err = $input.first().json ?? {};\n\nconst detail = err.error?.message ?? err.error ?? err.message ?? 'unknown stage failure';\nconst code = err.code ?? err.error?.code ?? 'SYSTEM_ERROR';\n\nthrow new Error('BrandForge run ' + runId + ' halted [' + code + ']: ' + detail);"
      },
      "id": "bf-node-016",
      "name": "Halt: Stage Failed",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        900,
        600
      ]
    }
