{
  "name": "BrandForge — Brand to Campaign",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "brandforge",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "bf-node-001",
      "name": "01 Intake Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2.1,
      "position": [
        -620,
        300
      ],
      "webhookId": "brandforge-intake"
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Reject malformed calls before any downstream work is scheduled.\nconst body = $input.first().json.body ?? $input.first().json;\nconst runId = body.run_id;\n\nif (typeof runId !== 'string' || !/^run_[0-9]{14}_[a-f0-9]{8}$/.test(runId)) {\n  throw new Error('INVALID_INTAKE: run_id missing or malformed: ' + JSON.stringify(runId));\n}\n\nreturn [{ json: { run_id: runId, accepted_at: new Date().toISOString() } }];"
      },
      "id": "bf-node-002",
      "name": "02 Validate Intake",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -420,
        300
      ]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ JSON.stringify({ accepted: true, run_id: $json.run_id }) }}",
        "options": {
          "responseCode": 202
        }
      },
      "id": "bf-node-003",
      "name": "03 Respond 202",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.5,
      "position": [
        -220,
        300
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "language": "javaScript",
        "jsCode": "// Single source of truth for the rest of the run. Downstream nodes read\n// these values via $('Init Run Context') rather than re-deriving them.\nconst runId = $input.first().json.run_id;\n\nreturn [{\n  json: {\n    run_id: runId,\n    api_base: 'http://localhost:3001',\n    // Must match INTERNAL_TOKEN in the api service's .env\n    internal_token: 'dev-internal-token-change-me',\n    started_at: new Date().toISOString(),\n  },\n}];"
      },
      "id": "bf-node-004",
      "name": "Init Run Context",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -20,
        300
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "http://localhost:3001/internal/brand-cache",
        "sendHeaders": true,
        "specifyHeaders": "json",
        "jsonHeaders": "={{ JSON.stringify({ \"x-internal-token\": $('Init Run Context').first().json.internal_token }) }}",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ run_id: $('Init Run Context').first().json.run_id }) }}",
        "options": {
          "timeout": 30000,
          "response": {
            "response": {
              "neverError": false
            }
          }
        }
      },
      "id": "bf-node-005",
      "name": "04 Brand Cache Lookup",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        180,
        300
      ],
      "onError": "continueErrorOutput"
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cache-miss",
              "leftValue": "={{ $json.cache_hit }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "false",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "bf-node-006",
      "name": "05 Crawl Needed?",
