# ---------- Models ----------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

OPENAI_API_KEY=
OPENAI_IMAGE_MODEL=gpt-image-2.5
OPENAI_IMAGE_SIZE=1024x1024
OPENAI_IMAGE_QUALITY=high

# ---------- Services ----------
API_PORT=3001
CRAWLER_PORT=3002
WEB_PORT=5173
CRAWLER_URL=http://localhost:3002
API_URL=http://localhost:3001
N8N_WEBHOOK_URL=http://localhost:5678/webhook/brandforge

# Shared secret between n8n and the api internal endpoints
INTERNAL_TOKEN=dev-internal-token-change-me

# ---------- Crawler bounds ----------
MAX_CRAWL_PAGES=12
MAX_PRODUCT_PAGES=5
MAX_REFERENCE_IMAGES=24
PAGE_TIMEOUT_MS=20000
TOTAL_CRAWL_TIMEOUT_MS=120000
CRAWL_CONCURRENCY=3
MIN_IMAGE_WIDTH=400
MIN_IMAGE_HEIGHT=400

# ---------- Generation ----------
GENERATION_CONCURRENCY=3
GENERATION_TIMEOUT_MS=180000
MAX_GENERATION_RETRIES=2
MAX_REPAIR_ATTEMPTS=2

# ---------- QA thresholds ----------
QA_MIN_PRODUCT_ACCURACY=7
QA_MIN_REALISM=6
QA_MIN_BRAND_ALIGNMENT=6

# ---------- Upload ----------
MAX_UPLOAD_BYTES=12000000

# ---------- Cache ----------
BRAND_PROFILE_TTL_HOURS=168

# ---------- Storage ----------
DATA_DIR=./data
